  },
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "bin": {
    "instagram-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
